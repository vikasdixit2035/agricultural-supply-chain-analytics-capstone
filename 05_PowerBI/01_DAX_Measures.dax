Harvest Qty kg = SUM(fact_harvest_lots[harvest_qty_kg])
Accepted Qty kg = SUM(fact_harvest_lots[accepted_qty_kg])
Quality Rejection Rate = DIVIDE(SUM(fact_harvest_lots[rejected_qty_kg]), [Harvest Qty kg])
Procurement Spend INR = SUMX(fact_harvest_lots, fact_harvest_lots[accepted_qty_kg] * fact_harvest_lots[purchase_price_inr_per_kg])
Avg PPV % = AVERAGEX(fact_harvest_lots, DIVIDE(fact_harvest_lots[purchase_price_inr_per_kg]-fact_harvest_lots[market_reference_price_inr_per_kg],fact_harvest_lots[market_reference_price_inr_per_kg]))
Inbound Loss Rate = DIVIDE(SUM(fact_inbound_shipments[transport_loss_kg]), SUM(fact_inbound_shipments[received_qty_kg]) + SUM(fact_inbound_shipments[transport_loss_kg]))
Temperature Excursion Rate = DIVIDE(CALCULATE(COUNTROWS(fact_inbound_shipments),fact_inbound_shipments[temperature_excursion_hours]>2),COUNTROWS(fact_inbound_shipments))
Spoilage Qty kg = SUM(fact_inventory_lot_status[estimated_spoilage_qty_kg])
Usable Closing Stock kg = SUM(fact_inventory_lot_status[usable_closing_qty_kg])
Average Fill Rate = AVERAGE(fact_customer_orders[fill_rate])
OTIF = AVERAGE(fact_customer_orders[otif_flag])
Customer Rejection Rate = DIVIDE(SUM(fact_customer_orders[customer_rejected_qty_kg]),SUM(fact_customer_orders[delivered_qty_kg]))
Net Sales INR = SUM(fact_customer_orders[net_sales_inr])
